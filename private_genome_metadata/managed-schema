<?xml version="1.0" encoding="UTF-8"?>
<schema name="private_genome_metadata" version="1.6">
  <!-- Field type definitions (must come before fields in Solr 9.x) -->
  <fieldType name="string" class="solr.StrField" sortMissingLast="true" docValues="true"/>
  <fieldType name="strings" class="solr.StrField" sortMissingLast="true" multiValued="true" docValues="true"/>
  <fieldType name="string_raw" class="solr.StrField" sortMissingLast="true"/>
  <fieldType name="boolean" class="solr.BoolField" sortMissingLast="true"/>
  <fieldType name="booleans" class="solr.BoolField" sortMissingLast="true" multiValued="true"/>
  <fieldType name="int" class="solr.IntPointField" docValues="true"/>
  <fieldType name="float" class="solr.FloatPointField" docValues="true"/>
  <fieldType name="long" class="solr.LongPointField" docValues="true"/>
  <fieldType name="double" class="solr.DoublePointField" docValues="true"/>
  <fieldType name="pint" class="solr.IntPointField" docValues="true"/>
  <fieldType name="pfloat" class="solr.FloatPointField" docValues="true"/>
  <fieldType name="plong" class="solr.LongPointField" docValues="true"/>
  <fieldType name="pdouble" class="solr.DoublePointField" docValues="true"/>
  <fieldType name="pints" class="solr.IntPointField" docValues="true" multiValued="true"/>
  <fieldType name="pfloats" class="solr.FloatPointField" docValues="true" multiValued="true"/>
  <fieldType name="plongs" class="solr.LongPointField" docValues="true" multiValued="true"/>
  <fieldType name="pdoubles" class="solr.DoublePointField" docValues="true" multiValued="true"/>
  <fieldType name="random" class="solr.RandomSortField" indexed="true"/>
  <fieldType name="pdate" class="solr.DatePointField" docValues="true"/>
  <fieldType name="pdates" class="solr.DatePointField" docValues="true" multiValued="true"/>
  <fieldType name="text_custom" class="solr.TextField" positionIncrementGap="100">
    <analyzer type="index">
      <tokenizer class="solr.WhitespaceTokenizerFactory"/>
      <filter class="solr.WordDelimiterGraphFilterFactory" generateWordParts="1" generateNumberParts="1" catenateWords="1" catenateNumbers="1" catenateAll="1" splitOnCaseChange="0" splitOnNumerics="1" preserveOriginal="1"/>
      <filter class="solr.FlattenGraphFilterFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.WhitespaceTokenizerFactory"/>
      <filter class="solr.WordDelimiterGraphFilterFactory" generateWordParts="1" generateNumberParts="1" catenateWords="0" catenateNumbers="0" catenateAll="0" splitOnCaseChange="0" splitOnNumerics="1" preserveOriginal="0"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
  </fieldType>
  <fieldType name="string_ci" class="solr.SortableTextField" sortMissingLast="true" omitNorms="true" docValues="true">
    <analyzer type="index">
      <tokenizer class="solr.KeywordTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <filter class="solr.WordDelimiterGraphFilterFactory" stemEnglishPossessive="1" splitOnNumerics="1" splitOnCaseChange="1" generateWordParts="1" generateNumberParts="1" catenateWords="1" catenateNumbers="1" catenateAll="1" preserveOriginal="1"/>
      <filter class="solr.FlattenGraphFilterFactory"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.KeywordTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <filter class="solr.WordDelimiterGraphFilterFactory" stemEnglishPossessive="1" splitOnNumerics="1" splitOnCaseChange="1" generateWordParts="1" generateNumberParts="1" catenateWords="1" catenateNumbers="1" catenateAll="1" preserveOriginal="1"/>
    </analyzer>
  </fieldType>
  <fieldType name="text_general" class="solr.TextField" positionIncrementGap="100" multiValued="true">
    <analyzer type="index">
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
  </fieldType>

  <fields>
    <!-- Unique identifier; generated by the keygen update chain in solrconfig.xml -->
    <field name="id" type="string" indexed="true" stored="true"/><!-- UUID -->

    <!-- Link to the genome collection -->
    <field name="genome_id" type="string" indexed="true" stored="true"/>
    <field name="genome_name" type="string_ci" indexed="true" stored="true"/>
    <field name="taxon_id" type="int" indexed="true" stored="true"/>

    <!-- Submitting laboratory -->
    <field name="lab_id" type="string" indexed="true" stored="true"/>
    <field name="lab_key" type="string" indexed="true" stored="true"/>

    <!-- Host / patient -->
    <field name="host_name" type="string_ci" indexed="true" stored="true"/>
    <field name="patient_age" type="string_ci" indexed="true" stored="true"/>
    <field name="patient_age_days" type="int" indexed="true" stored="true"/>
    <field name="patient_age_months" type="int" indexed="true" stored="true"/>
    <field name="patient_age_years" type="int" indexed="true" stored="true"/>
    <field name="patient_sex" type="string_ci" indexed="true" stored="true"/>

    <!-- Isolation and geography -->
    <field name="isolation_source" type="string_ci" indexed="true" stored="true"/>
    <field name="isolation_country" type="string_ci" indexed="true" stored="true"/>
    <field name="state_province" type="string_ci" indexed="true" stored="true"/>
    <field name="county" type="string_ci" indexed="true" stored="true"/>
    <field name="city" type="string_ci" indexed="true" stored="true"/>

    <!-- Dates. collection_date is free text, matching the genome collection. -->
    <field name="collection_date" type="string" indexed="true" stored="true"/>
    <field name="received_date" type="pdate" indexed="true" stored="true"/>
    <field name="upload_date" type="pdate" indexed="true" stored="true"/>
    <field name="modified_date" type="pdate" indexed="true" stored="true"/>

    <!-- Typing and characterization -->
    <field name="serovar" type="string_ci" indexed="true" stored="true"/>
    <field name="pathovar" type="string_ci" indexed="true" stored="true"/>
    <field name="lineage" type="string" indexed="true" stored="true"/>
    <field name="allele_code" type="string" indexed="true" stored="true"/>
    <field name="antigen" type="string_ci" indexed="true" stored="true"/>
    <field name="toxin" type="string_ci" indexed="true" stored="true" multiValued="true"/>
    <field name="toxin_wgs" type="string_ci" indexed="true" stored="true" multiValued="true"/>
    <field name="outbreak" type="string_ci" indexed="true" stored="true"/>

    <!-- Standard metadata fields -->
    <field name="text" type="text_custom" indexed="true" stored="false" multiValued="true"/>
    <field name="_version_" type="long" indexed="true" stored="true"/>

    <field name="date_inserted" type="pdate" indexed="true" stored="true" default="NOW"/>
    <field name="date_modified" type="pdate" indexed="true" stored="true" default="NOW"/>

    <!-- Privilege control -->
    <field name="public" type="boolean" indexed="true" stored="true"/>
    <field name="owner" type="string" indexed="true" stored="true"/>
    <field name="user_read" type="string" indexed="true" stored="true" multiValued="true"/>
    <field name="user_write" type="string" indexed="true" stored="true" multiValued="true"/>
  </fields>

  <uniqueKey>id</uniqueKey>

  <!-- Copy only searchable text fields. Lab and patient identifiers
       (lab_id, lab_key, patient_age*, patient_sex) are deliberately excluded
       from the free-text index. -->
  <copyField source="genome_id" dest="text"/>
  <copyField source="genome_name" dest="text"/>
  <copyField source="taxon_id" dest="text"/>
  <copyField source="host_name" dest="text"/>
  <copyField source="isolation_source" dest="text"/>
  <copyField source="isolation_country" dest="text"/>
  <copyField source="state_province" dest="text"/>
  <copyField source="county" dest="text"/>
  <copyField source="city" dest="text"/>
  <copyField source="serovar" dest="text"/>
  <copyField source="pathovar" dest="text"/>
  <copyField source="lineage" dest="text"/>
  <copyField source="allele_code" dest="text"/>
  <copyField source="antigen" dest="text"/>
  <copyField source="toxin" dest="text"/>
  <copyField source="toxin_wgs" dest="text"/>
  <copyField source="outbreak" dest="text"/>
</schema>
